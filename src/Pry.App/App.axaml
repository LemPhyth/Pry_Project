<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Pry.App.App" RequestedThemeVariant="Default">
  <Application.Resources>
    <SolidColorBrush x:Key="PryAccentBrush" Color="#B148C6"/>
    <SolidColorBrush x:Key="PryAccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PryCanvasBrush" Color="#0E1621"/>
    <SolidColorBrush x:Key="PryPanelBrush" Color="#17212B"/>
    <SolidColorBrush x:Key="PryCardBrush" Color="#182533"/>
    <SolidColorBrush x:Key="PryPopupBrush" Color="#182533"/>
    <SolidColorBrush x:Key="PryBorderBrush" Color="#263746"/>
    <SolidColorBrush x:Key="PryTextBrush" Color="#F2F6FA"/>
    <SolidColorBrush x:Key="PryMutedBrush" Color="#8EA2B5"/>
    <SolidColorBrush x:Key="PryButtonBrush" Color="#273442"/>
    <SolidColorBrush x:Key="PryButtonHoverBrush" Color="#344556"/>
    <SolidColorBrush x:Key="PryButtonPressedBrush" Color="#40566B"/>
    <SolidColorBrush x:Key="PrySelectionBrush" Color="#563069"/>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Icon" Value="/Assets/Pry.ico"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource PryTextBrush}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Foreground" Value="{DynamicResource PryTextBrush}"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Background" Value="{DynamicResource PryButtonBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource PryButtonHoverBrush}"/></Style>
    <Style Selector="Button:pressed"><Setter Property="Background" Value="{DynamicResource PryButtonPressedBrush}"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource PryAccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource PryAccentTextBrush}"/></Style>
    <Style Selector="Button.primary:pointerover"><Setter Property="Background" Value="{DynamicResource PryAccentHoverBrush}"/></Style>
    <Style Selector="Button.primary:pressed"><Setter Property="Background" Value="{DynamicResource PryAccentPressedBrush}"/></Style>
    <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource PryFocusBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.5"/></Style>
    <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource PryErrorBrush}"/></Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PryButtonHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource PryTextBrush}"/></Style>
    <Style Selector="Button:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PryButtonPressedBrush}"/></Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource PryErrorBrush}"/></Style>
    <Style Selector="ComboBox, NumericUpDown"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="CornerRadius" Value="8"/></Style>
    <Style Selector="CheckBox"><Setter Property="Foreground" Value="{DynamicResource PryTextBrush}"/></Style>
    <Style Selector="Expander"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="FlyoutPresenter, MenuFlyoutPresenter"><Setter Property="Background" Value="{DynamicResource PryPopupBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PryBorderBrush}"/><Setter Property="CornerRadius" Value="12"/></Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown"><Setter Property="Foreground" Value="{DynamicResource PryTextBrush}"/><Setter Property="Background" Value="{DynamicResource PryCardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PryControlBorderBrush}"/><Setter Property="MinHeight" Value="36"/></Style>
    <Style Selector="TextBox:focus"><Setter Property="BorderBrush" Value="{DynamicResource PryFocusBrush}"/></Style>
    <Style Selector="Button.composer-action"><Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/></Style>
    <Style Selector="Button.recording"><Setter Property="Background" Value="#D75454"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.sidebar-nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,11"/>
    </Style>
    <Style Selector="Button.sidebar-nav:pointerover"><Setter Property="Background" Value="{DynamicResource PryButtonHoverBrush}"/></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource PrySelectionBrush}"/></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PrySelectionBrush}"/></Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PryButtonHoverBrush}"/></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PryAccentHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource PryAccentTextBrush}"/></Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PryAccentPressedBrush}"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderBrush" Value="{DynamicResource PryBorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="ScrollViewer.pry-chat-scroll ScrollBar:vertical">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Margin" Value="0,8,2,8"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ScrollViewer.pry-chat-scroll ScrollBar:vertical /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource PryAccentBrush}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="ScrollViewer.pry-chat-scroll ScrollBar:vertical /template/ RepeatButton">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="ScrollViewer.pry-settings-scroll ScrollBar:vertical">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Margin" Value="0,4,2,4"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ScrollViewer.pry-settings-scroll ScrollBar:vertical /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource PryAccentBrush}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style Selector="ScrollViewer.pry-settings-scroll ScrollBar:vertical /template/ RepeatButton">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
  </Application.Styles>
</Application>
